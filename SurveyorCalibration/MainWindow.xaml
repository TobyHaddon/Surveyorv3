<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx xmlns:winex="using:WinUIEx" 
    x:Class="Surveyor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor"    
    xmlns:controls="using:Surveyor.Controls"
    xmlns:surveyorControls="using:Surveyor.User_Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d"
    Title="Surveyor Calibration Frames Extractor"
    Width="1600"
    Height="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />   <!-- Hidden row 3 for Content Dialog -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" 
                    Background="Transparent" 
                    HorizontalAlignment="Left"
                    IsOpen="False" 
                    DefaultLabelPosition="Bottom" 
                    IsSticky="True">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="OpenFile" Label="Open..." Click="OpenAppBarButton_Click"/>

                <!-- Arrow icon between buttons -->
                <AppBarButton Label="" IsEnabled="false">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72A;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Name="FindAppBarButton" Icon="Find" Label="Find" Click="FindAppBarButton_Click"/>
                <AppBarButton x:Name="FindAppBarCancel" Icon="Cancel"  Click="FindAppBarCancel_Click" />

                <!-- Arrow icon between buttons -->
                <AppBarButton Label="" IsEnabled="false">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72A;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Name="SaveAppBarButton" Icon="Save" Label="Save" Click="SaveAppBarButton_Click"/>
            </CommandBar.PrimaryCommands>
            
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Setting" Label="Settings">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="I" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        
        <Grid x:Name="MonoCalibrationHeads" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Mono Head -->
            <controls:UniversalCalibrationHeadUserControl x:Name="LeftMonoCalibrationHead" 
                                                          Head="Mono" 
                                                          Grid.Row="0" 
                                                          Grid.Column="0" 
                                                          Margin="5,5,0,5"/>
            
            <!-- Vertical sizer -->

            <toolkit:GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Right Mono Head -->
            <controls:UniversalCalibrationHeadUserControl x:Name="RightMonoCalibrationHead" 
                                                          Head="Mono" 
                                                          Grid.Row="0" 
                                                          Grid.Column="2"
                                                          Margin="5,5,5,5"/>


        
        </Grid>

        <!-- Horizontal sizer -->        

        <toolkit:GridSplitter Grid.Row="2"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>


        <controls:UniversalCalibrationHeadUserControl x:Name="StereoCalibrationHead" 
                                                      Head="Stereo" 
                                                      Grid.Row="4"                                                      
                                                      Margin="5,5,5,5"/>

        <!--New Survey Dialog-->
        <Grid x:Name="SurveyInfoAndMediaContentDialogGrid" Grid.Row="3">
                    <ContentDialog x:Name="CalibrationMediaContentDialog"
                        Title="Calibration Media Setup"
                        PrimaryButtonText="OK"
                        SecondaryButtonText="Cancel"
                        DefaultButton="Primary"
                        MinWidth="300"
                        MaxWidth="860"
                        MinHeight="200"
                        MaxHeight="400"
                        IsPrimaryButtonEnabled="True"
                        RequestedTheme="Default">
                <surveyorControls:CalibInfoAndMedia x:Name="CalibrationMediaUserControl" />
            </ContentDialog>
        </Grid>
    </Grid>
    
</winex:WindowEx>
