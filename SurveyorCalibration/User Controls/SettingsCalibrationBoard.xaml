<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.SettingsCalibrationBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:cal="using:SurveyorCalibrationData"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:PreferredCalibrationItemVisibilityConverter x:Key="PreferredCalibrationItemVisibilityConverter" />
        <local:DoubleFormatConverter x:Key="Double2Converter" Format="F2" />
        <local:DoubleFormatConverter x:Key="Double3Converter" Format="F3" />
        <local:CalibrationIntrinsicElementConverter x:Key="IntrinsicElementConverter" />
        <local:DoubleSubtractConverter x:Key="MinusCardPaddingConverter" />
        <local:CalibrationDistortionElementConverter x:Key="DistortionElementConverter" />
        <local:StereoMatrixVectorConverter x:Key="StereoMatrixVectorConverter" />
    </UserControl.Resources>

    <toolkit:SettingsExpander  x:Name="SettingsExpanderCalibration" Header="Calibration">
        <toolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xEB3C;" />
        </toolkit:SettingsExpander.HeaderIcon>

        <toolkit:SettingsExpander.Items>
            <!-- MULTIPLE CALIBRATION SETS -->
            <toolkit:SettingsCard Header="Multiple Calibration Sets" Description="">

            </toolkit:SettingsCard>


        </toolkit:SettingsExpander.Items>
    </toolkit:SettingsExpander>
</UserControl>
