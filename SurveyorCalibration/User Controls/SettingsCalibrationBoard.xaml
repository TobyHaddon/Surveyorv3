<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.SettingsCalibrationBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:cal="using:SurveyorCalibrationData"
    xmlns:converters="using:Surveyor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:surveyor="using:Surveyor"     
    x:Name="Root"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:MetersToMillimetersConverter x:Key="MetersToMillimetersConverter2DP" Format="F2" />
        <converters:MetersToMillimetersConverter x:Key="MetersToMillimetersConverter0DP" Format="F0" />
    </UserControl.Resources>
    
    <!-- Board Parameter & Preview Grid -->
    <Grid x:Name="RootGrid" Grid.Row="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- Row 0: Board Type -->
            <RowDefinition Height="Auto"/><!-- Row 1: Square Count -->
            <RowDefinition Height="Auto"/><!-- Row 2: Square Size -->
            <RowDefinition Height="Auto"/><!-- Row 3: Marker Size -->
            <RowDefinition Height="Auto"/><!-- Row 4: ArUco Dictionary -->
            <RowDefinition Height="Auto"/><!-- Row 5: Preview -->
            <RowDefinition Height="Auto"/><!-- Row 6: Board Physical Size Title & Button -->
            <RowDefinition Height="Auto"/><!-- Row 7: Board Physical Size -->
            <RowDefinition Height="Auto"/><!-- Row 8: Dot Per Squares Inch -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Board Type -->
        <TextBlock Text="Target Type:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <!-- Locked to single supported option in code behind-->
        <ComboBox x:Name="TargetTypeCombo"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5">
        </ComboBox>
        
        <!-- Square Count -->
        <TextBlock Text="Square Count:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="5">
            <TextBox x:Name="SquareColsNumeric" Width="60" 
                        Text="{x:Bind CbdWorking.SquaresX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        TextChanging="NumberTextBoxPositiveWholeNumber_TextChanging"
                        TextChanged="NumericTextBox_TextChanged" />
            <TextBlock Text=" x " VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SquareRowsNumeric" Width="60" 
                        Text="{x:Bind CbdWorking.SquaresY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanging="NumberTextBoxPositiveWholeNumber_TextChanging"
                        TextChanged="NumericTextBox_TextChanged"/>
        </StackPanel>

        <!--Square Size-->
        <TextBlock Text="Square Size:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="5">
            <TextBox x:Name="SquareSizeNumeric" Width="60" 
                        Text="{x:Bind CbdWorking.SquareLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MetersToMillimetersConverter2DP}}" 
                        TextChanging="NumberTextBoxPositiveDecimal2DP_TextChanging"
                        TextChanged="NumericTextBox_TextChanged"/>
            <TextBlock Text=" mm" VerticalAlignment="Center" Margin="0,0,5,0"/>
        </StackPanel>

        <!--Marker Size-->
        <TextBlock Text="Marker Size:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="5">
            <TextBox x:Name="MarkerSizeNumeric" Width="60" 
                        Text="{x:Bind CbdWorking.MarkerLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MetersToMillimetersConverter2DP}}" 
                        TextChanging="NumberTextBoxPositiveDecimal2DP_TextChanging"
                        TextChanged="NumericTextBox_TextChanged"/>
            <TextBlock Text=" mm" VerticalAlignment="Center" Margin="0,0,5,0"/>
        </StackPanel>
        
        <!-- ArUco Dictionary -->
        <TextBlock Text="ArUco Dictionary:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="ArucoDictionaryCombo" Grid.Row="4" Grid.Column="1" Margin="5"
                    SelectionChanged="ArucoDictionaryCombo_SelectionChanged"
                    SelectedItem="{x:Bind CbdWorking.PredefinedDictionaryName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

        <!-- Preview -->
        <StackPanel Grid.Row ="5" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" Margin="5">
            <Border Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" 
                    BorderBrush="Gray" BorderThickness="1" Width="500" Margin="0,15,0,0">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="PreviewCaption1" FontSize="10" Foreground="Gray" Margin="0,5,5,0"/>
            <TextBlock x:Name="PreviewCaption2" FontSize="10" Foreground="Gray" Margin="0,0,5,5"/>
        </StackPanel>


        <!-- Board Generation (only if Type="DefaultsManager) -->
        <!-- Border background spanning rows 6-8 -->
        <Border Grid.Row="6"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>

        <!-- Board Phyiscal Size Title-->
        <TextBlock Text="Generate PDF for physical board manufacturing" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,10,5,5"/>

        <TextBlock Text="Board Size:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <!-- Save to PDF Button -->
        <Button x:Name="SaveToPDFButton" Grid.Row="6" Grid.Column="1" Content="Save to PDF" Click="SaveToPDF_Click" Width="150" HorizontalAlignment="Right" Margin="0,10,10,0"/>

        <!-- Board Phyiscal Size -->
        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1" Margin="5">
            <TextBox x:Name="BoardSizeXNumeric" Width="60" 
                        Text="{x:Bind BoardSizeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MetersToMillimetersConverter0DP}}" 
                        TextChanging="NumberTextBoxPositiveDecimal2DP_TextChanging"
                        TextChanged="GenerationTextBox_TextChanged"/>
            <TextBlock Text=" mm  x " VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="BoardSizeYNumeric" Width="60" 
                        Text="{x:Bind BoardSizeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MetersToMillimetersConverter0DP}}" 
                        TextChanging="NumberTextBoxPositiveDecimal2DP_TextChanging"
                        TextChanged="GenerationTextBox_TextChanged"/>
            <TextBlock Text=" mm" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="(size of printed board including margins)" Grid.Row="6" Grid.ColumnSpan="2" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="5,0,5,0"/>
        </StackPanel>


        <!-- Dot Per Squares Inch -->
        <TextBlock Text="Print Resolution:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="6"/>
        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="1" Margin="6">
            <TextBox x:Name="BoardDPI" Width="60" 
                        Text="{x:Bind PrintDPI, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        TextChanging="NumberTextBoxPositiveWholeNumber_TextChanging"
                        TextChanged="GenerationTextBox_TextChanged"/>
            <TextBlock Text=" Dots Per Inch (DPI)" VerticalAlignment="Center" Margin="0,0,5,0"/>
        </StackPanel>

    </Grid>
</UserControl>
