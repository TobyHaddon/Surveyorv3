<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.Controls.CalibrationIterationViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="MainPanel" Padding="0" Height="120">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>            <!-- Reprojection RMS/P95Error Graphs -->
                <ColumnDefinition Width="Auto"/>         <!-- Inputs & counts -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>           <!-- Titles -->
                <RowDefinition Height="100"/>            <!-- Graphs or inputs & count -->
            </Grid.RowDefinitions>

            <!-- Column 0: Movement and Blur -->
            <!-- Used for the title of the Head e.g. Stereo Left -->
            <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="0"
                                                    Text=""                                   
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    FontFamily="Segoe UI Variable"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Margin="0,0,0,0"/>
            <!-- Frame Movement and Blur Graphs -->
            <Border x:Name="GraphsBorder" Grid.Row="1" Grid.Column="0"
                                                    BorderBrush="Gray"
                                                    BorderThickness="2"
                                                    HorizontalAlignment="Stretch"  VerticalAlignment="Top">
                <Grid Height="100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Canvas x:Name="CalibrationResultsCanvas" Grid.Row="0" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            </Border>


            <!-- Column 1: Inputs and Counts -->
            <TextBlock x:Name="InputsAndCountsTitle" Grid.Row="0" Grid.Column="1"
                                                    Text="Inputs &amp; Counts"                                       
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    FontFamily="Segoe UI Variable"
                                                    FontSize="10"                        
                                                    Margin="0,0,0,0"/>

            <Border x:Name="InputsAndCountsBorder" Grid.Row="1" Grid.Column="1"
                                                    BorderBrush="Gray"
                                                    BorderThickness="2" Margin="5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">                    <TextBlock x:Name="InputsAndCountsText"                               FontFamily="Consolas"                               FontSize="10"                               TextWrapping="Wrap"                               TextTrimming="None"                               xml:space="preserve" />                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</UserControl>
