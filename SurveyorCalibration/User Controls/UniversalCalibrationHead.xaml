<?xml version="1.0" encoding="utf-8"?><UserControl    x:Class="Surveyor.Controls.UniversalCalibrationHead"    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    xmlns:local="using:Surveyor"    xmlns:controls="using:Surveyor.Controls"    xmlns:h="using:Surveyor.Helper"    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"    mc:Ignorable="d">    <UserControl.Resources>        <x:String x:Key="MoveToolTipText">The amount of movement detected between frames</x:String>        <x:String x:Key="BlurToolTipText">The amount of blur detected in the frame</x:String>        <x:String x:Key="YawToolTipText">The detected tilt of the calibration board in the left/right direction (yaw). A positive angle means the left side is nearer to you</x:String>        <x:String x:Key="PitchToolTipText">The detected tilt of the calibration board in the up/down direction (pitch). A positive angle means the board is tilted forward</x:String>        <x:String x:Key="FeaturesToolTipText">The number of markers detected on the calibration board. For stereo detection it is count of the corresponding markers found on the left and right calibration board i.e. marker is only counted if it can be seen on the left and the right side simultaneously</x:String>        <x:String x:Key="ScoreToolTipText">A quality score calculated for this frame</x:String>        <x:String x:Key="FrameRMSToolTipText">The RMS calculated for this frame</x:String>        <x:String x:Key="FrameMaxErrorToolTipText">The maximum error calculated for this frame</x:String>        <x:String x:Key="FrameIndexToolTipText">Video frame index number</x:String>        <x:String x:Key="PositionToolTipText">Time position in video</x:String>        <x:String x:Key="CalibrationFrameStatusToolTipText">Indicates if this frame is used in the calibration process or if it was manually excluded. The reason it is included is shown either because of its frame coverage position, the pose of the target or manually added</x:String>        <x:String x:Key="IncludeFrameToolTipText">Always force the calibration calculate to use this frame</x:String>        <x:String x:Key="ExcludeFrameToolTipText">Always exclude this frame from the calibration calculation</x:String>        <x:String x:Key="RemoveAllIncludedFramesToolTipText">Remove all the include flags i.e. no frames will be forced to be included in the calibration calculation</x:String>        <x:String x:Key="RemoveAllExcludedFramesToolTipText">Remove all the exclude flags i.e. no frames will be manually excluded from the calibration calculation</x:String>                <MenuFlyout x:Key="HeadContextMenu" Closing="HeadContextMenu_Closing">            <ToggleMenuFlyoutItem x:Name="HeadContextMenuIncludeFrame"                             Text="Include Frame"                            ToolTipService.ToolTip="{StaticResource IncludeFrameToolTipText}"                            Click="HeadContextMenuIncludeFrame_Click">            </ToggleMenuFlyoutItem>            <ToggleMenuFlyoutItem x:Name="HeadContextMenuExcludeFrame"                             Text="Exclude Frame"                              ToolTipService.ToolTip="{StaticResource ExcludeFrameToolTipText}"                            Click="HeadContextMenuExcludeFrame_Click">            </ToggleMenuFlyoutItem>            <MenuFlyoutSeparator/>            <MenuFlyoutItem x:Name="HeadContextMenuRemoveAllIncludedFrames"                             Text="Remove All Included Frames"                             ToolTipService.ToolTip="{StaticResource RemoveAllIncludedFramesToolTipText}"                            Click="HeadContextMenuRemoveAllIncludedFrames_Click">            </MenuFlyoutItem>            <MenuFlyoutItem x:Name="HeadContextMenuRemoveAllExcludedFrames"                             Text="Remove All Excluded Frames"                             ToolTipService.ToolTip="{StaticResource RemoveAllExcludedFramesToolTipText}"                            Click="HeadContextMenuRemoveAllExcludedFrames_Click">            </MenuFlyoutItem>        </MenuFlyout>    </UserControl.Resources>    <Grid x:Name="RootGrid">        <Grid.RowDefinitions>            <RowDefinition Height="Auto" />            <RowDefinition Height="*" />        </Grid.RowDefinitions>        <Grid.ColumnDefinitions>            <ColumnDefinition Width="*" />            <ColumnDefinition Width="*" />        </Grid.ColumnDefinitions>        <!-- Movement and Blur Graphs, Sensor Bins and Pose Bins -->        <controls:CalibrationFrameSetViewer x:Name="CalibrationFrameSetViewerLeft" Grid.Column="0"                                              HorizontalAlignment="Stretch" />        <controls:CalibrationFrameSetViewer x:Name="CalibrationFrameSetViewerRight" Grid.Column="1"                                              HorizontalAlignment="Stretch"/>        <!-- Left Side Video Image Control and Calibration Result TextBlock -->        <Grid x:Name="LeftGrid" Grid.Column="0" Grid.Row="1">            <Grid.RowDefinitions>                <RowDefinition Height="*" />                <RowDefinition Height="Auto" />                <RowDefinition Height="Auto" />            </Grid.RowDefinitions>            <Grid.ColumnDefinitions>                <ColumnDefinition Width="Auto" />                <ColumnDefinition Width="*" />                <ColumnDefinition Width="Auto" />            </Grid.ColumnDefinitions>            <!-- Left: replace StackPanel with a 2-row Grid -->            <Grid Grid.Column="1" Grid.Row="0">                <Grid.RowDefinitions>                    <RowDefinition Height="*" />                    <RowDefinition Height="Auto" />                </Grid.RowDefinitions>                <!-- Overlay container -->                <Grid x:Name="LeftOverlayContainer" Grid.Row="0" Margin="0,2,0,0"                      SizeChanged="OverlayContainer_SizeChanged"                      PointerPressed="OverlayContainer_PointerPressed">                    <Image x:Name="LeftImage"                                                      Stretch="Uniform"                           HorizontalAlignment="Center" VerticalAlignment="Top"/>                    <Canvas x:Name="LeftSensorCoverage"                            IsHitTestVisible="False"                            Visibility="Collapsed"                            HorizontalAlignment="Left"                            VerticalAlignment="Top"                            Background="#FF323232"/>                </Grid>                                <controls:MediaTimeLineDisplayUserControl x:Name="MediaTimeLineDisplayLeft"                                               Grid.Row="1"                                               HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,1,0,1"/>            </Grid>            <!-- Left: Calibration Results -->            <Border x:Name="LeftCalibDataBorder" Grid.Column="2" Grid.Row="0" BorderBrush="Gray"                     BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Collapsed" Margin="3">                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">                    <TextBlock x:Name="LeftCalibDataText"                               FontFamily="Consolas"                               FontSize="10"                               TextWrapping="Wrap"                               TextTrimming="None"                               xml:space="preserve" />                </ScrollViewer>            </Border>            <!-- Left: Frame Metadata -->            <Border x:Name="LeftFrameMetadataBorder" Grid.Column="1" Grid.Row="0" BorderBrush="Gray"                     BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Visible" Width="70" Margin="1,3,0,0"                    HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000"                    PointerPressed="MetaData_PointerPressed">                <Grid>                    <Grid.ColumnDefinitions>                        <ColumnDefinition Width="Auto" />                        <ColumnDefinition Width="*" />                    </Grid.ColumnDefinitions>                    <Grid.RowDefinitions>                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                    </Grid.RowDefinitions>                    <!-- Row 0 -->                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">                        <FontIcon Glyph="&#xE7C2;" FontSize="16" ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="LeftMoveText"                                   Grid.Row="0" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>                    <!-- Row 1: Blur -->                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <Image x:Name="LeftBlurIconLabel" Source="ms-appx:///Assets/BlurCircle-Dark.png"                                   Margin="0,0,0,0"                                   VerticalAlignment="Center" HorizontalAlignment="Left"                                   Width="16" Height="16"                                   Stretch="Uniform"                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="LeftBlurText"                                   Grid.Row="1" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>                    <!-- Row 2: Yaw (left/right tilt) -->                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <FontIcon Glyph="&#xE809;" FontSize="16"  ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="LeftYawText"                                    Grid.Row="2" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>                    <!-- Row 3: Pitch (up/down tilt) -->                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <FontIcon Glyph="&#xE809;" FontSize="16" RenderTransformOrigin="0.5,0.5"                                      ToolTipService.ToolTip="{StaticResource PitchToolTipText}">                            <FontIcon.RenderTransform>                                <RotateTransform Angle="-90"/>                            </FontIcon.RenderTransform>                        </FontIcon>                    </StackPanel>                    <TextBlock x:Name="LeftPitchText"                                   Grid.Row="3" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource PitchToolTipText}"/>                    <!-- Row 4: Feature Count -->                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <Image x:Name="LeftFeatureCountIconLabel" Source="ms-appx:///Assets/ArucoSmall-Dark.png"                                   Margin="0,0,0,0"                                   VerticalAlignment="Center" HorizontalAlignment="Left"                                   Width="16" Height="16"                                   Stretch="Uniform"                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="LeftFeatureCountText"                                   Grid.Row="4" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>                    <!-- Row 5: Score  -->                    <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">                        <FontIcon Glyph="&#xE208;" FontSize="16" ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="LeftScoreText"                                    Grid.Row="5" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    <!-- Row 6: Frame RMS -->                    <RichTextBlock Grid.Row="6" Grid.Column="0" FontFamily="Segoe UI Variable" FontSize="18"                                    IsTextSelectionEnabled="False"                                    ToolTipService.ToolTip="{StaticResource FrameRMSToolTipText}">                        <Paragraph Margin="0">                            <Run Text="σ"/>                            <InlineUIContainer>                                <TextBlock Text="r" FontSize="8" FontFamily="Segoe UI Variable"                                            RenderTransformOrigin="0,1">                                    <TextBlock.RenderTransform>                                        <!-- X pulls it left; Y pushes it down to look like a subscript -->                                        <TranslateTransform X="-6" Y="4"/>                                    </TextBlock.RenderTransform>                                </TextBlock>                            </InlineUIContainer>                        </Paragraph>                    </RichTextBlock>                    <TextBlock x:Name="LeftFrameRMSText"                                    Grid.Row="6" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource FrameRMSToolTipText}"/>                    <!-- Row 7: Frame Max Error -->                    <RichTextBlock Grid.Row="7" Grid.Column="0" FontFamily="Segoe UI Variable" FontSize="18"                                    IsTextSelectionEnabled="False"                                    ToolTipService.ToolTip="{StaticResource FrameMaxErrorToolTipText}">                        <Paragraph Margin="0">                            <Run Text="ε"/>                            <InlineUIContainer>                                <TextBlock Text="max" FontSize="8" FontFamily="Segoe UI Variable"                                            RenderTransformOrigin="0,1">                                    <TextBlock.RenderTransform>                                        <!-- X pulls it left; Y pushes it down to look like a subscript -->                                        <TranslateTransform X="-6" Y="4"/>                                    </TextBlock.RenderTransform>                                </TextBlock>                            </InlineUIContainer>                        </Paragraph>                    </RichTextBlock>                    <TextBlock x:Name="LeftFrameMaxErrorText"                                    Grid.Row="7" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource FrameMaxErrorToolTipText}"/>                    <!-- Row 8: Frame Index  -->                    <TextBlock Grid.Row="8" Grid.Column="0"                                 Text="#" FontSize="16"                                 VerticalAlignment="Center" Margin="4,0,4,0"                                ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    <TextBlock x:Name="LeftFrameIndex"                                    Grid.Row="8" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource FrameIndexToolTipText}"/>                    <!-- Row 9: Position  -->                    <StackPanel Grid.Row="9" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">                        <FontIcon Glyph="&#xE916;" FontSize="16" ToolTipService.ToolTip="{StaticResource PositionToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="LeftPosition"                                    Grid.Row="9" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    <!-- Row 10: Calibration Frame Status (Coverage, Pose, Ignore, Manual Add) -->                    <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <Image Source="ms-appx:///Assets/CalibrationFrameStatus-Dark.png"                                   Margin="0,0,0,0"                                   VerticalAlignment="Center" HorizontalAlignment="Left"                                   Width="16" Height="16"                                   Stretch="Uniform"                                   ToolTipService.ToolTip="{StaticResource CalibrationFrameStatusToolTipText}"/>                    </StackPanel>                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Vertical">                        <TextBlock x:Name="LeftCalibrationFrameStatusBest"                                                   FontSize="8"                                        Margin="0,2,0,2"                                        VerticalAlignment="Center"                                        TextWrapping="Wrap"                                        ToolTipService.ToolTip="{StaticResource CalibrationFrameStatusToolTipText}" />                        <TextBlock x:Name="LeftCalibrationFrameStatusManual"                                                   FontSize="8"                                        Foreground="Red"                                        Margin="0,2,0,2"                                        VerticalAlignment="Center"                                        TextWrapping="Wrap"                                        ToolTipService.ToolTip="{StaticResource CalibrationFrameStatusToolTipText}" />                    </StackPanel>                </Grid>            </Border>            <!-- Left: Media Controls -->            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"                 Spacing="10" Margin="0,0,0,0">                <!-- Go to start of the calibration board zone or start of the video, E622 -->                <Button x:Name="LeftGotoStartButton" Height="30" Padding="16,4"                        Click="LeftGotoStartButton_Click"                        PointerPressed="LeftGotoStartButton_PointerPressed"                        ToolTipService.ToolTip="Go to the start of the where the calibration board as been detected. Right click to go to start of the media. If no calibration board has been detected go to the start of the media">                    <FontIcon Glyph="&#xE622;"/>                </Button>                <!-- Play or Pause Media Control Button, F5B0 or F8AE -->                <Button x:Name="LeftPlayPauseButton" Height="30" Padding="16,4" Click="LeftPlayPauseClick">                    <FontIcon x:Name ="LeftPlayPauseIcon" Glyph="&#xF5B0;"/>                </Button>                <TextBox x:Name="LeftGoToFrameTextBox" Height="30" VerticalAlignment="Center"                         PlaceholderText="Go to..."                         KeyDown="LeftGotoFrameTextBox_KeyDown"                          LostFocus="LeftGotoFrameTextBox_LostFocus"/>                <!-- Frame Back Media Control Button, E973 -->                <Button x:Name="LeftFrameBackButton" Height="30" Padding="16,4" Click="LeftFrameBackClick"                        ToolTipService.ToolTip="Frame back">                    <FontIcon Glyph="&#xE973;"/>                </Button>                <!-- Frame Forward Media Control Button, E974 -->                <Button x:Name="LeftFrameForwardButton" Height="30" Padding="16,4" Click="LeftFrameForwardClick"                        ToolTipService.ToolTip="Frame forward">                    <FontIcon Glyph="&#xE974;"/>                </Button>                <!-- Go to end of the calibration board zone or end of the video, E623 -->                <Button x:Name="LeftGotoEndButton" Height="30" Padding="16,4"                         Click="LeftGotoEndButton_Click"                        PointerPressed="LeftGotoEndButton_PointerPressed"                        ToolTipService.ToolTip="Go to the end of the where the calibration board as been detected. Right click to go to end of the media. If no calibration board has been detected go to the end of the media">                    <FontIcon Glyph="&#xE623;"/>                </Button>            </StackPanel>            <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"                     Margin="0,5,0,0">                <StackPanel Orientation="Vertical">                    <TextBlock x:Name="LeftFrameInfoLabel" Width ="120" FontSize="12"/>                    <TextBlock x:Name="LeftTimeInfoLabel" Width ="120" FontSize="12"/>                </StackPanel>            </StackPanel>                                </Grid>        <!-- Right Side Video Image Control and Calibration Result TextBlock -->        <Grid x:Name="RightGrid" Grid.Column="1" Grid.Row="1">            <Grid.RowDefinitions>                <RowDefinition Height="*" />                <RowDefinition Height="Auto" />                <RowDefinition Height="Auto" />            </Grid.RowDefinitions>            <Grid.ColumnDefinitions>                <ColumnDefinition Width="Auto" />                <ColumnDefinition Width="*" />                <ColumnDefinition Width="Auto" />            </Grid.ColumnDefinitions>            <!--Right: Image and time line control -->            <Grid Grid.Column="1" Grid.Row="0">                <Grid.RowDefinitions>                    <RowDefinition Height="*" />                    <RowDefinition Height="Auto" />                </Grid.RowDefinitions>                <!-- Overlay container -->                <Grid x:Name="RightOverlayContainer" Grid.Row="0" Margin="0,2,0,0"                      SizeChanged="OverlayContainer_SizeChanged"                      PointerPressed="OverlayContainer_PointerPressed">                                        <Image x:Name="RightImage"                                                      Stretch="Uniform"                           HorizontalAlignment="Center" VerticalAlignment="Top"/>                    <Canvas x:Name="RightSensorCoverage"                            IsHitTestVisible="False"                            Visibility="Collapsed"                            HorizontalAlignment="Left"                            VerticalAlignment="Top"                            Background="#FF323232"/>                </Grid>                                <controls:MediaTimeLineDisplayUserControl x:Name="MediaTimeLineDisplayRight"                                               Grid.Row="1"                                               HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,1,0,1"/>            </Grid>            <!-- Right: Frame Metadata -->            <Border x:Name="RightFrameMetadataBorder" Grid.Column="1" Grid.Row="0" BorderBrush="Gray"                     BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Visible" Width="70" Margin="1,3,0,0"                    HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000"                    PointerPressed="MetaData_PointerPressed">                <Grid>                    <Grid.ColumnDefinitions>                        <ColumnDefinition Width="Auto" />                        <ColumnDefinition Width="*" />                    </Grid.ColumnDefinitions>                    <Grid.RowDefinitions>                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                        <RowDefinition Height="Auto" />                    </Grid.RowDefinitions>                    <!-- Row 0 -->                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">                        <FontIcon Glyph="&#xE7C2;" FontSize="16" ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="RightMoveText"                                   Grid.Row="0" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>                    <!-- Row 1: Blur -->                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <Image x:Name="RightBlurIconLabel" Source="ms-appx:///Assets/BlurCircle-Dark.png"                                   Margin="0,0,0,0"                                   VerticalAlignment="Center" HorizontalAlignment="Left"                                   Width="16" Height="16"                                   Stretch="Uniform"                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="RightBlurText"                                   Grid.Row="1" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>                    <!-- Row 2: Yaw (left/right tilt) -->                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <FontIcon Glyph="&#xE809;" FontSize="16"  ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="RightYawText"                                    Grid.Row="2" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>                    <!-- Row 3: Pitch (up/down tilt) -->                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <FontIcon Glyph="&#xE809;" FontSize="16" RenderTransformOrigin="0.5,0.5"                                      ToolTipService.ToolTip="{StaticResource PitchToolTipText}">                            <FontIcon.RenderTransform>                                <RotateTransform Angle="-90"/>                            </FontIcon.RenderTransform>                        </FontIcon>                    </StackPanel>                    <TextBlock x:Name="RightPitchText"                                   Grid.Row="3" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource PitchToolTipText}"/>                    <!-- Row 4: Feature Count -->                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <Image x:Name="RightFeatureCountIconLabel" Source="ms-appx:///Assets/ArucoSmall-Dark.png"                                   Margin="0,0,0,0"                                   VerticalAlignment="Center" HorizontalAlignment="Left"                                   Width="16" Height="16"                                   Stretch="Uniform"                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="RightFeatureCountText"                                   Grid.Row="4" Grid.Column="1" FontSize="12"                                   Margin="0,2,0,2" VerticalAlignment="Center"                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>                    <!-- Row 5: Score  -->                    <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">                        <FontIcon Glyph="&#xE208;" FontSize="16" ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="RightScoreText"                                    Grid.Row="5" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    <!-- Row 6: Frame RMS -->                    <RichTextBlock Grid.Row="6" Grid.Column="0" FontFamily="Segoe UI Variable" FontSize="18"                                    IsTextSelectionEnabled="False"                                   ToolTipService.ToolTip="{StaticResource FrameRMSToolTipText}">                        <Paragraph Margin="0">                            <Run Text="σ"/>                            <InlineUIContainer>                                <TextBlock Text="r" FontSize="8" FontFamily="Segoe UI Variable"                                            RenderTransformOrigin="0,1">                                    <TextBlock.RenderTransform>                                        <!-- X pulls it left; Y pushes it down to look like a subscript -->                                        <TranslateTransform X="-6" Y="4"/>                                    </TextBlock.RenderTransform>                                </TextBlock>                            </InlineUIContainer>                        </Paragraph>                    </RichTextBlock>                    <TextBlock x:Name="RightFrameRMSText"                                    Grid.Row="6" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource FrameRMSToolTipText}"/>                    <!-- Row 7: Frame Max Error -->                    <RichTextBlock Grid.Row="7" Grid.Column="0" FontFamily="Segoe UI Variable" FontSize="18"                                    IsTextSelectionEnabled="False"                                   ToolTipService.ToolTip="{StaticResource FrameMaxErrorToolTipText}">                        <Paragraph Margin="0">                            <Run Text="ε"/>                            <InlineUIContainer>                                <TextBlock Text="max" FontSize="8" FontFamily="Segoe UI Variable"                                            RenderTransformOrigin="0,1">                                    <TextBlock.RenderTransform>                                        <!-- X pulls it left; Y pushes it down to look like a subscript -->                                        <TranslateTransform X="-6" Y="4"/>                                    </TextBlock.RenderTransform>                                </TextBlock>                            </InlineUIContainer>                        </Paragraph>                    </RichTextBlock>                    <TextBlock x:Name="RightFrameMaxErrorText"                                    Grid.Row="7" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource FrameMaxErrorToolTipText}"/>                    <!-- Row 8: Frame Index  -->                    <TextBlock Grid.Row="8" Grid.Column="0"                                 Text="#" FontSize="16"                                 VerticalAlignment="Center" Margin="4,0,4,0"                                ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    <TextBlock x:Name="RightFrameIndex"                                    Grid.Row="8" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource FrameIndexToolTipText}"/>                                        <!-- Row 9: Position  -->                    <StackPanel Grid.Row="9" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">                        <FontIcon Glyph="&#xE916;" FontSize="16" ToolTipService.ToolTip="{StaticResource PositionToolTipText}"/>                    </StackPanel>                    <TextBlock x:Name="RightPosition"                                    Grid.Row="9" Grid.Column="1" FontSize="12"                                    Margin="0,2,0,2" VerticalAlignment="Center"                                    ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>                    <!-- Row 10: Calibration Frame Status (Coverage, Pose, Ignore, Manual Add) -->                    <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">                        <Image Source="ms-appx:///Assets/CalibrationFrameStatus-Dark.png"                                   Margin="0,0,0,0"                                   VerticalAlignment="Center" HorizontalAlignment="Left"                                   Width="16" Height="16"                                   Stretch="Uniform"                                   ToolTipService.ToolTip="{StaticResource CalibrationFrameStatusToolTipText}"/>                    </StackPanel>                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Vertical">                        <TextBlock x:Name="RightCalibrationFrameStatusBest"                                                   FontSize="8"                                        Margin="0,2,0,2"                                        VerticalAlignment="Center"                                        TextWrapping="Wrap"                                        ToolTipService.ToolTip="{StaticResource CalibrationFrameStatusToolTipText}" />                        <TextBlock x:Name="RightCalibrationFrameStatusManual"                                                   FontSize="8"                                        Margin="0,2,0,2"                                        Foreground="Red"                                        VerticalAlignment="Center"                                        TextWrapping="Wrap"                                        ToolTipService.ToolTip="{StaticResource CalibrationFrameStatusToolTipText}" />                    </StackPanel>                </Grid>            </Border>            <!-- Right Side Media Controls -->            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"                 Spacing="10" Margin="0,0,0,0">                <!-- Go to start of the calibration board zone or start of the video, E622 -->                <!--ToolTipService.ToolTip="Go to the start of the where the calibration board as been detected. Double click to go to start of the media. If no calibration board has been detected go to the start of the media"-->                <Button x:Name="RightGotoStartButton" Height="30" Padding="16,4"                         Click="RightGotoStartButton_Click"                        PointerPressed="RightGotoStartButton_PointerPressed"                        ToolTipService.ToolTip="Go to the start of the where the calibration board as been detected. Right click to go to start of the media. If no calibration board has been detected go to the start of the media">                    <FontIcon Glyph="&#xE622;"/>                </Button>                <!-- Play or Pause Media Control Button, F5B0 or F8AE -->                <Button x:Name="RightPlayPauseButton" Height="30" Padding="16,4" Click="RightPlayPauseClick">                    <FontIcon x:Name ="RightPlayPauseIcon" Glyph="&#xF5B0;"/>                </Button>                <TextBox x:Name="RightGoToFrameTextBox" Height="30" VerticalAlignment="Center"                          PlaceholderText="Go to..."                         KeyDown="RightGotoFrameTextBox_KeyDown"                          LostFocus="RightGotoFrameTextBox_LostFocus"/>                <!-- Frame Back Media Control Button, E973 -->                <Button x:Name="RightFrameBackButton" Height="30" Padding="16,4" Click="RightFrameBackClick"                        ToolTipService.ToolTip="Frame back">                    <FontIcon Glyph="&#xE973;"/>                </Button>                <!-- Frame Forward Media Control Button, E974 -->                <Button x:Name="RightFrameForwardButton" Height="30" Padding="16,4" Click="RightFrameForwardClick"                        ToolTipService.ToolTip="Frame forward">                    <FontIcon Glyph="&#xE974;"/>                </Button>                <!-- Go to end of the calibration board zone or end of the video, E623 -->                <!--ToolTipService.ToolTip="Go to the end of the where the calibration board as been detected. Double click to go to end of the media. If no calibration board has been detected go to the end of the media">-->                <Button x:Name="RightGotoEndButton" Height="30" Padding="16,4"                         Click="RightGotoEndButton_Click"                        PointerPressed="RightGotoEndButton_PointerPressed"                        ToolTipService.ToolTip="Go to the end of the where the calibration board as been detected. Right click to go to end of the media. If no calibration board has been detected go to the end of the media">                    <FontIcon Glyph="&#xE623;"/>                </Button>            </StackPanel>            <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"                     Margin="0,5,0,0">                <StackPanel Orientation="Vertical">                    <TextBlock x:Name="RightFrameInfoLabel" Width ="120" FontSize="12"/>                    <TextBlock x:Name="RightTimeInfoLabel" Width ="120" FontSize="12"/>                </StackPanel>            </StackPanel>                    </Grid>                        <!--???TODELELTE NOT USED BUT CHECK MAYBE A GOOD FEATURE-->        <!--<controls:ImageStripViewer x:Name="LeftImageViewer" Grid.Column="0" Grid.Row="4" Margin="0,5,0,0" Visibility="Collapsed"/>-->        <!--<controls:ImageStripViewer x:Name="RightImageViewer" Grid.Column="1" Grid.Row="4"  Margin="0,5,0,0"  Visibility="Collapsed"/>-->    </Grid></UserControl>