<?xml version="1.0" encoding="utf-8"?>
    <UserControl
    x:Class="Surveyor.Controls.CalibrationFrameSetViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="600">

    <UserControl.Content>
        <Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Visible">
                <Grid x:Name="MainPanel" Padding="0" Height="150">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>    <!-- Movement and Blur -->
                        <ColumnDefinition Width="Auto"/>    <!-- Sensor Coverage -->
                        <ColumnDefinition Width="Auto"/>    <!-- Pose -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Titles -->
                        <RowDefinition Height="*"/>  <!-- Graphs or Bins -->
                    </Grid.RowDefinitions>

                    <!-- Column 0: Movement and Blur -->
                    <!-- Used for the title of the Head e.g. Stero Left -->
                    <TextBlock x:Name="HeadTitle" Grid.Row="0" Grid.Column="0"
                                                    Text=""                                   
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    FontFamily="Segoe UI Variable"
                                                    FontSize="12"
                                                    Padding="0" Margin="6,0,0,0"/>
                    <!-- Frame Movement and Blur Graphs -->
                    <Border x:Name="GraphsBorder" Grid.Row="1" Grid.Column="0"
                                                    BorderBrush="Gray"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Stretch">
                        <Grid Width="300">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Canvas x:Name="MovementCanvas" Grid.Row="0"/>
                            <Canvas x:Name="BlurCanvas" Grid.Row="1"/>
                        </Grid>
                    </Border>


                    <!-- Column 1: Sensor coverage -->
                    <TextBlock x:Name="SensorBinTitle" Grid.Row="0" Grid.Column="1"
                                                    Text="Camera Sensor Coverage"                                       
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    FontFamily="Segoe UI Variable"
                                                    FontSize="10"                        
                                                    Padding="0" Margin="6,0,0,0"/>

                    <GridView x:Name="SensorBinGridItemsControl" Grid.Row="1" Grid.Column="1"
                                                    VerticalAlignment="Stretch" HorizontalAlignment="Left"                                            
                                                    IsItemClickEnabled="False"
                                                    SelectionMode="None"
                                                    Padding="0" Margin="0">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>


                    <!-- Column 2: Pose diversity -->
                    <TextBlock x:Name="PoseBinTitle" Grid.Row="0" Grid.Column="2"
                                                    Text="Frame Pose Diversity"                                   
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    FontFamily="Segoe UI Variable"
                                                    FontSize="10"                                   
                                                    Padding="0" Margin="6,0,0,0"/>

                    <Grid x:Name="PoseBinGridItemsControl" Grid.Row="1" Grid.Column="2"
                                                    Width="180"
                                                    VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                                    Background="Gray">
                    </Grid>

                </Grid>
            </ScrollViewer>

        </Grid>
    </UserControl.Content>
</UserControl>

