<UserControl
    x:Class="Surveyor.User_Controls.ProcessingInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:Surveyor.Converters">
    <Grid>
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </Grid.Resources>

        <controls:InfoBar x:Name="InfoBar"
                          IsOpen="False"
                          Severity="Informational"
                          IsClosable="False"
                          Title="{x:Bind Title, Mode=OneWay}"
                          Message="{x:Bind Message, Mode=OneWay}">
            <InfoBar.ActionButton>
                <!-- Right: Cancel button -->
                <Button Grid.Column="1"
                    x:Name="CancelBtn"
                    Content="{x:Bind CancelButtonText, Mode=OneWay}"
                    Visibility="{Binding CancelButton, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CancelButton_OnClick"/>
            </InfoBar.ActionButton>
        </controls:InfoBar>
    </Grid>
</UserControl>