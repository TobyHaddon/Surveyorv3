<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.Export"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--Export Dialog-->
    <Grid MinWidth="700" MaxWidth="700" MinHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-left: Export format -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Spacing="8">
            <TextBlock Text="Format" FontWeight="SemiBold"/>
            <StackPanel Orientation="Vertical" Spacing="2">
                <RadioButton x:Name="FormatNative" Content="Native (Stereo only)" GroupName="ExportFormat" IsChecked="True" Checked="FormatChanged"/>
                <RadioButton x:Name="FormatOpenCV" Content="OpenCV" GroupName="ExportFormat" Checked="FormatChanged"/>
                <RadioButton x:Name="FormatText" Content="Text" GroupName="ExportFormat" Checked="FormatChanged"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,15">
                    <Hyperlink Click="MailLinkFormat_Click">Need other formats?</Hyperlink>
                </TextBlock>

                <TextBlock Text="Distortion Mode"  FontWeight="SemiBold"/>
                <RadioButton x:Name="Model_K1K2P1P2"
                             GroupName="ExportDistortionModelModel" IsChecked="True" Checked="ModelChanged">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="2">
                        <TextBlock Text="k1-k2, p1-p2" />
                        <TextBlock x:Name="Model_K1K2P1P2_Result" Text="RPE:3.45" Opacity="0.8" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Model_K1K2K3P1P2" 
                             GroupName="ExportDistortionModelModel" Checked="ModelChanged">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="2">
                        <TextBlock Text="k1-k3, p1-p2" />
                        <TextBlock x:Name="Model_K1K2K3P1P2_Result" Text="RPE:3.45" Opacity="0.8" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Model_K1K2K3K4P1P2" GroupName="ExportDistortionModelModel" Checked="ModelChanged">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="2">
                        <TextBlock Text="k1-k4, p1-p2" />
                        <TextBlock x:Name="Model_K1K2K3K4P1P2_Result" Text="RPE:3.45" Opacity="0.8" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Model_K1K2K3K4P1P2K5K6" GroupName="ExportDistortionModelModel" Checked="ModelChanged">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="2">
                        <TextBlock Text="k1-k6, p1-p2" />
                        <TextBlock x:Name="Model_K1K2K3K4P1P2K5K6_Result" Text="RPE:3.45" Opacity="0.8" FontSize="12"/>
                    </StackPanel>
                </RadioButton>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,15">
                    <Hyperlink Click="MailLinkModel_Click">Need other distortion models?</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Top-right: Preview -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Preview" FontWeight="SemiBold" Margin="10,0,0,0"/>
            <Border Grid.Row="1" 
                    BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                    Padding="8"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Margin="10,0,0,0">
                <Grid>
                    <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PreviewText" Text="Select a language to load a sample..." 
                                   FontFamily="Consolas" FontSize="10" 
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: NavigationView for code samples -->
        <NavigationView x:Name="ExportSamplesNav"
                Grid.Row="1" Grid.ColumnSpan="2"
                PaneDisplayMode="Top"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                SelectionChanged="ExportSamplesNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="C#" Tag="cs"/>
                <NavigationViewItem Content="C++" Tag="cpp"/>
                <NavigationViewItem Content="Python" Tag="py"/>
            </NavigationView.MenuItems>
            <!-- Markdown code viewer -->
            <ScrollViewer x:Name="CodeMarkdownScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <controls:MarkdownTextBlock x:Name="CodeMarkdown"
                                            Text=""
                                            CodeFontFamily="Consolas"
                                            TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- TextBlock in the PaneFooter -->
            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopySampleButton" Click="CopySampleButton_Click"
                            ToolTipService.ToolTip="Copy the code sample"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            Padding="3"
                            Margin="0,0,0,0">
                        <FontIcon Glyph="&#xE8C8;" />
                    </Button>
                </StackPanel>

            </NavigationView.PaneFooter>

        </NavigationView>
    </Grid>
 
</UserControl>
