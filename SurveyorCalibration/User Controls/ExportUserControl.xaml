<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.ExportUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--Export Dialog-->
    <Grid x:Name="ExportContentDialogHost">
        <ContentDialog x:Name="ExportContentDialog"
        Title="Export"
        PrimaryButtonText="Save"
        SecondaryButtonText="Cancel"
        DefaultButton="Primary"
        IsPrimaryButtonEnabled="True"
        PrimaryButtonClick="ExportDialog_Save_Click"
        SecondaryButtonClick="ExportDialog_Cancel_Click">
            <Grid Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Top-left: Export format -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Spacing="8">
                    <TextBlock Text="Format"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="FormatNative" Content="Native" GroupName="ExportFormat" IsChecked="True"/>
                        <RadioButton x:Name="FormatOpenCV" Content="OpenCV" GroupName="ExportFormat"/>
                        <RadioButton x:Name="FormatPdf" Content="PDF" GroupName="ExportFormat"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top-right: Preview -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Spacing="8">
                    <TextBlock Text="Preview" FontWeight="SemiBold"/>
                    <Border BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8" Height="160">
                        <!-- Swap between text preview or image preview in code-behind -->
                        <Grid>
                            <TextBlock x:Name="PreviewText" Text="Preview will appear here..." TextWrapping="Wrap"/>
                            <Image x:Name="PreviewImage" Visibility="Collapsed" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom: NavigationView for code samples -->
                <NavigationView x:Name="ExportSamplesNav"
            Grid.Row="1" Grid.ColumnSpan="2"
            PaneDisplayMode="Top"
            SelectionChanged="ExportSamplesNav_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="C#" Tag="cs"/>
                        <NavigationViewItem Content="C++" Tag="cpp"/>
                        <NavigationViewItem Content="Python" Tag="py"/>
                    </NavigationView.MenuItems>
                    <Frame x:Name="ExportSamplesFrame"/>
                </NavigationView>
            </Grid>
        </ContentDialog>
    </Grid>

</UserControl>
