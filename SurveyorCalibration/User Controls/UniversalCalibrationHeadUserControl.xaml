<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.Controls.UniversalCalibrationHeadUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor"
    xmlns:controls="using:Surveyor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:String x:Key="MoveToolTipText">The amount of movement detected between frames</x:String>
        <x:String x:Key="BlurToolTipText">The amount of blur detected in the frame</x:String>
        <x:String x:Key="YawToolTipText">The detected tilt of the calibration board in the left/right direction (yaw). A positive angle means the left side is nearer to you</x:String>
        <x:String x:Key="PitchToolTipText">The detected tilt of the calibration board in the up/down direction (pitch). A positive angle means the board is tilted forward</x:String>
        <x:String x:Key="FeaturesToolTipText">The number of markers detected on the calibration board. For stereo detection it is count of the corresponding markers found on the left and right calibration board i.e. marker is only counted if it can be seen on the left and the right side simultaneously</x:String>
        <x:String x:Key="ScoreToolTipText">A quality score calucated for this frame</x:String>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!--<RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Movement and Blur Graphs, Sensor Bins and Pose Bins -->
        <controls:CalibrationFrameSetViewer x:Name="CalibrationFrameSetViewerLeft" Grid.Column="0"  
                                            HorizontalAlignment="Center"/>
        <controls:CalibrationFrameSetViewer x:Name="CalibrationFrameSetViewerRight" Grid.Column="1"  
                                            HorizontalAlignment="Center"/>

        <!-- Left Side Video Image Control and Calibration Result TextBlock -->
        <Grid x:Name="LeftGrid" Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: replace StackPanel with a 2-row Grid -->
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image x:Name="LeftImage" Grid.Row="0"                           
                           Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"                           
                           Margin="0,2,0,0" SizeChanged="LeftImage_SizeChanged"/>
                           
                <controls:CalibrationBoardTimeLineUserControl x:Name="CalibrationBoardTimeLineLeft"
                                               Grid.Row="1"
                                               HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,2,0,0"/>
            </Grid>

            <!-- Left: Calibration Results -->
            <Border x:Name="LeftCalibDataBorder" Grid.Column="2" Grid.Row="0" BorderBrush="Gray" 
                    BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Collapsed" Margin="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="LeftCalibDataText"
                               FontFamily="Consolas"
                               FontSize="10"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               xml:space="preserve" />
                </ScrollViewer>
            </Border>

            <!-- Left: Frame Metadata -->
            <Border x:Name="LeftFrameMetadataBorder" Grid.Column="0" Grid.Row="0" BorderBrush="Gray" 
                    BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Visible" Width="75" Margin="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">
                            <FontIcon Glyph="&#xE7C2;" FontSize="16" ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="LeftMoveText"
                                   Grid.Row="0" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>

                        <!-- Row 1: Blur -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <Image x:Name="LeftBlurIconLabel" Source="ms-appx:///Assets/BlurCircle-Dark.png"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Width="16" Height="16"
                                   Stretch="Uniform"
                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="LeftBlurText"
                                   Grid.Row="1" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>

                        <!-- Row 2: Yaw (left/right tilt) -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <FontIcon Glyph="&#xE809;" FontSize="16"  ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="LeftYawText"
                                    Grid.Row="2" Grid.Column="1" FontSize="12"
                                    Margin="0,2,0,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>

                        <!-- Row 3: Pitch (up/down tilt) -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <FontIcon Glyph="&#xE809;" FontSize="16" RenderTransformOrigin="0.5,0.5"
                                      ToolTipService.ToolTip="{StaticResource PitchToolTipText}">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </StackPanel>
                        <TextBlock x:Name="LeftPitchText"
                                   Grid.Row="3" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource PitchToolTipText}"/>

                        <!-- Row 4: Feature Count -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <Image x:Name="LeftFeatureCountIconLabel" Source="ms-appx:///Assets/ArucoSmall-Dark.png"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Width="16" Height="16"
                                   Stretch="Uniform"
                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="LeftFeatureCountText"
                                   Grid.Row="4" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>
                
                        <!-- Row 5: Score  -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">
                            <FontIcon Glyph="&#xE208;" FontSize="16" ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="LeftScoreText"
                                    Grid.Row="5" Grid.Column="1" FontSize="12"
                                    Margin="0,2,0,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Left: Media Controls -->
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" 
                Spacing="10" Margin="0,3,0,0">
                <!-- Go to start of the calibration board zone or start of the video, E622 -->
                <!--ToolTipService.ToolTip="Go to the start of the where the calibration board as been detected. Double click to go to start of the media. If no calibration board has been detected go to the start of the media"-->
                <Button x:Name="LeftGotoStartButton" Height="30" Padding="16,4" Click="LeftGotoStartClick"
                        ToolTipService.ToolTip="Go to the start of the media">
                    <FontIcon Glyph="&#xE622;"/>
                </Button>
                <!-- Play or Pause Media Control Button, F5B0 or F8AE -->
                <Button x:Name="LeftPlayPauseButton" Height="30" Padding="16,4" Click="LeftPlayPauseClick">
                    <FontIcon x:Name ="LeftPlayPauseIcon" Glyph="&#xF5B0;"/>
                </Button>
                <TextBox x:Name="LeftGoToFrameTextBox" Height="30" VerticalAlignment="Center"
                         PlaceholderText="Go to..."
                         KeyDown="LeftGotoFrameTextBox_KeyDown" 
                         LostFocus="LeftGotoFrameTextBox_LostFocus"/>
                <!-- Frame Back Media Control Button, E973 -->
                <Button x:Name="LeftFrameBackButton" Height="30" Padding="16,4" Click="LeftFrameBackClick"
                        ToolTipService.ToolTip="Frame back">
                    <FontIcon Glyph="&#xE973;"/>
                </Button>
                <!-- Frame Forward Media Control Button, E974 -->
                <Button x:Name="LeftFrameForwardButton" Height="30" Padding="16,4" Click="LeftFrameForwardClick"
                        ToolTipService.ToolTip="Frame forward">
                    <FontIcon Glyph="&#xE974;"/>
                </Button>
                <!-- Go to end of the calibration board zone or end of the video, E623 -->
                <!--ToolTipService.ToolTip="Go to the end of the where the calibration board as been detected. Double click to go to end of the media. If no calibration board has been detected go to the end of the media">-->
                <Button x:Name="LeftGotoEndButton" Height="30" Padding="16,4" Click="LeftGotoEndClick"                        
                        ToolTipService.ToolTip="Go to the end of the media">
                    <FontIcon Glyph="&#xE623;"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" 
                    Margin="0,5,0,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="LeftFrameInfoLabel" Width ="120" FontSize="12"/>
                    <TextBlock x:Name="LeftTimeInfoLabel" Width ="120" FontSize="12"/>
                </StackPanel>
            </StackPanel>
                        
        </Grid>


        <!-- Right Side Video Image Control and Calibration Result TextBlock -->
        <Grid x:Name="RightGrid" Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--Right: Image and time line control -->
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image x:Name="RightImage" Grid.Row="0"                           
                           Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"                           
                           Margin="0,2,0,0" SizeChanged="RightImage_SizeChanged"/>

                <controls:CalibrationBoardTimeLineUserControl x:Name="CalibrationBoardTimeLineRight"
                                               Grid.Row="1"
                                               HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,2,0,0"/>
            </Grid>

            <!-- Right: Calibration Results -->
            <Border x:Name="RightCalibDataBorder" Grid.Column="2" Grid.Row="0" BorderBrush="Gray" 
                    BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Collapsed" Margin="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="RightCalibDataText"
                               FontFamily="Consolas"
                               FontSize="10"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               xml:space="preserve" />
                </ScrollViewer>
            </Border>

            <!-- Right: Frame Metadata -->
            <Border x:Name="RightFrameMetadataBorder" Grid.Column="0" Grid.Row="0" BorderBrush="Gray" 
                    BorderThickness="1" Padding="4" CornerRadius="2"  Visibility="Visible" Width="75" Margin="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">
                            <FontIcon Glyph="&#xE7C2;" FontSize="16" ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="RightMoveText"
                                   Grid.Row="0" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource MoveToolTipText}"/>

                        <!-- Row 1: Blur -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <Image x:Name="RightBlurIconLabel" Source="ms-appx:///Assets/BlurCircle-Dark.png"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Width="16" Height="16"
                                   Stretch="Uniform"
                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="RightBlurText"
                                   Grid.Row="1" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource BlurToolTipText}"/>

                        <!-- Row 2: Yaw (left/right tilt) -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <FontIcon Glyph="&#xE809;" FontSize="16"  ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="RightYawText"
                                    Grid.Row="2" Grid.Column="1" FontSize="12"
                                    Margin="0,2,0,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{StaticResource YawToolTipText}"/>

                        <!-- Row 3: Pitch (up/down tilt) -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <FontIcon Glyph="&#xE809;" FontSize="16" RenderTransformOrigin="0.5,0.5"
                                      ToolTipService.ToolTip="{StaticResource PitchToolTipText}">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </StackPanel>
                        <TextBlock x:Name="RightPitchText"
                                   Grid.Row="3" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource PitchToolTipText}"/>

                        <!-- Row 4: Feature Count -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                            <Image x:Name="RightFeatureCountIconLabel" Source="ms-appx:///Assets/ArucoSmall-Dark.png"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Width="16" Height="16"
                                   Stretch="Uniform"
                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="RightFeatureCountText"
                                   Grid.Row="4" Grid.Column="1" FontSize="12"
                                   Margin="0,2,0,2" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{StaticResource FeaturesToolTipText}"/>

                        <!-- Row 5: Score  -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">
                            <FontIcon Glyph="&#xE208;" FontSize="16" ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>
                        </StackPanel>
                        <TextBlock x:Name="RightScoreText"
                                    Grid.Row="5" Grid.Column="1" FontSize="12"
                                    Margin="0,2,0,2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{StaticResource ScoreToolTipText}"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Right Side Media Controls -->
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" 
                Spacing="10" Margin="0,3,0,0">
                <!-- Go to start of the calibration board zone or start of the video, E622 -->
                <!--ToolTipService.ToolTip="Go to the start of the where the calibration board as been detected. Double click to go to start of the media. If no calibration board has been detected go to the start of the media"-->
                <Button x:Name="RightGotoStartButton" Height="30" Padding="16,4" Click="RightGotoStartClick"
                        ToolTipService.ToolTip="Go to the start of the media">
                    <FontIcon Glyph="&#xE622;"/>
                </Button>
                <!-- Play or Pause Media Control Button, F5B0 or F8AE -->
                <Button x:Name="RightPlayPauseButton" Height="30" Padding="16,4" Click="RightPlayPauseClick">
                    <FontIcon x:Name ="RightPlayPauseIcon" Glyph="&#xF5B0;"/>
                </Button>
                <TextBox x:Name="RightGoToFrameTextBox" Height="30" VerticalAlignment="Center" 
                         PlaceholderText="Go to..."
                         KeyDown="RightGotoFrameTextBox_KeyDown" 
                         LostFocus="RightGotoFrameTextBox_LostFocus"/>
                <!-- Frame Back Media Control Button, E973 -->
                <Button x:Name="RightFrameBackButton" Height="30" Padding="16,4" Click="RightFrameBackClick"
                        ToolTipService.ToolTip="Frame back">
                    <FontIcon Glyph="&#xE973;"/>
                </Button>
                <!-- Frame Forward Media Control Button, E974 -->
                <Button x:Name="RightFrameForwardButton" Height="30" Padding="16,4" Click="RightFrameForwardClick"
                        ToolTipService.ToolTip="Frame forward">
                    <FontIcon Glyph="&#xE974;"/>
                </Button>
                <!-- Go to end of the calibration board zone or end of the video, E623 -->
                <!--ToolTipService.ToolTip="Go to the end of the where the calibration board as been detected. Double click to go to end of the media. If no calibration board has been detected go to the end of the media">-->
                <Button x:Name="RightGotoEndButton" Height="30" Padding="16,4" Click="RightGotoEndClick"
                        ToolTipService.ToolTip="Go to the end of the media">
                    <FontIcon Glyph="&#xE623;"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" 
                    Margin="0,5,0,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="RightFrameInfoLabel" Width ="120" FontSize="12"/>
                    <TextBlock x:Name="RightTimeInfoLabel" Width ="120" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            
        </Grid>
         

       

        <!--???TODELELTE NOT USED BUT CHECK MAYBE A GOOD FEATURE-->
        <!--<controls:ImageStripViewer x:Name="LeftImageViewer" Grid.Column="0" Grid.Row="4" Margin="0,5,0,0" Visibility="Collapsed"/>-->
        <!--<controls:ImageStripViewer x:Name="RightImageViewer" Grid.Column="1" Grid.Row="4"  Margin="0,5,0,0"  Visibility="Collapsed"/>-->

    </Grid>

</UserControl>
