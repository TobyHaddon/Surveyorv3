<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Surveyor.SetupRunCalibrationBoard"
	xmlns:local="using:Surveyor"
    xmlns:surveyorControls="using:Surveyor.User_Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    d:DataContext="{d:DesignInstance Type=local:CalibProject}"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="16">
        <TextBlock Text="Setup the Calibration Target" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Text="Configure the ChArUco board to match the physical one you are using. Ensure the ArUco markers exactly match the ones and positions on the actual board." FontSize="12" TextWrapping="Wrap"/>

        <surveyorControls:SettingsCalibrationBoard x:Name="CalibrationBoardSettingsControl"/>
    </StackPanel>
</Page>