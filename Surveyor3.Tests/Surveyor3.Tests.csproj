<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Make it a library (no AppX packaging, no resources.pri) -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Surveyor3.Tests</RootNamespace>
    <Nullable>enable</Nullable>

    <!-- Disable WinUI/MSIX pipeline for tests -->
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateResourcePriFile>false</GenerateResourcePriFile>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Remove UnitTestApp XAML shell (not needed as a library) -->
    <Compile Remove="UnitTestApp.xaml.cs" />
    <None Remove="UnitTestApp.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
  </ItemGroup>

  <!-- Reference ONLY the code you need (not the app project) -->
  <ItemGroup>
    <!-- Replace this with a reference to a shared core/library project after extracting logic -->
    <!-- <ProjectReference Include="..\Surveyorv3\Surveyorv3.csproj" /> -->
    <ProjectReference Include="..\SurveyorCalibrationData\SurveyorCalibrationData.csproj" />
  </ItemGroup>
</Project>
