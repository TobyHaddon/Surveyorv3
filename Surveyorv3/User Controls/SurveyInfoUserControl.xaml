<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.SurveyInfoUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:surveyorControls="using:Surveyor.User_Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>


        <!-- Survey Code User Control -->
        <surveyorControls:SurveyCodeUserControl x:Name="SurveyCodeUserControl" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                                Margin="0,0,0,0"/>

        <!--Survey Analyst Name-->
        <StackPanel Grid.Row="1" Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
            <TextBox x:Name="SurveyAnalystName" Width="250" 
                        PlaceholderText="Your Name" 
                        HorizontalAlignment="Left" 
                        TextChanged="SurveyAnalystName_TextChanged" />
            <FontIcon x:Name="SurveyAnalystNameValidationGlyph" FontSize="16" VerticalAlignment="Center"  Margin="8,0,0,0"/>
            <TextBlock x:Name="SurveyAnalystNameValidationText"  VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!--Species List Selection -->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
            <DropDownButton x:Name="SpeciesActiveListDropDown" Content="Select Species List">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SpeciesActiveListMenuFlyout"/>
                </DropDownButton.Flyout>
            </DropDownButton>
            <FontIcon x:Name="SpeciesActiveListValidationGlyph" FontSize="16" VerticalAlignment="Center"  Margin="8,0,0,0"/>
            <TextBlock x:Name="SpeciesActiveListValidationText"  VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <Button x:Name="EditButton" Grid.Row="2" Grid.Column="1"
                Content="Edit" HorizontalAlignment="Right"
                Margin="8,8,0,0" Click="EditButton_Click" />

    </Grid>
</UserControl>
