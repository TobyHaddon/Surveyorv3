<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.SpeciesSelector"
    x:Name="SpeciesSelectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="Auto"
    HorizontalAlignment="Stretch"
    MinWidth="450"
    MaxWidth="600"
    MinHeight="400"
    MaxHeight="600">


    <UserControl.Resources>
        <local:UriToImageSourceConverter x:Key="UriToImageSourceConverter"/>
        <local:AuthorDisplayConverter x:Key="AuthorDisplayConverter" />
        <DataTemplate x:Key="ImageTemplate" x:DataType="local:ImageDataObject">
            <StackPanel>
                <Image Source="{Binding ImageLocation, Converter={StaticResource UriToImageSourceConverter}}" 
                       Width="190" Height="130" Stretch="UniformToFill"/>
                <TextBlock Text="{Binding Author, Converter={StaticResource AuthorDisplayConverter}}"
                       TextAlignment="Center"
                       FontStyle="Italic"
                       FontSize="12"
                       Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Locality}"
                       FontStyle="Italic"
                       FontSize="12"
                       Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SexStage}"
                       FontStyle="Italic"
                       FontSize="12"
                       Margin="5,0,0,4" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- RMS rule info bar -->
        <InfoBar x:Name="RMSRuleInfoBar"
                 Grid.Row="0" Grid.ColumnSpan="2"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Title="RMS rule violation"                 
                 Margin="0,0,0,8">
            <ToolTipService.ToolTip>
                <ToolTip MaxWidth="520">
                    <StackPanel>
                        <TextBlock Text="The RMS shows the accuracy of the target points selected" TextWrapping="Wrap" />
                        <TextBlock Text="Cancel &amp; re-measure to ensure this measurement is included in the final survey results" TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
        </InfoBar>
        
        <!-- Range rule info bar -->
        <InfoBar x:Name="RangeRuleInfoBar"
                 Grid.Row="0" Grid.ColumnSpan="2"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Title="Range rule violation"                 
                 Margin="0,0,0,8">
            <ToolTipService.ToolTip>
                <ToolTip MaxWidth="520">
                    <StackPanel>
                        <TextBlock Text="Outside of the allowed distance from the camera rig" TextWrapping="Wrap" />
                        <TextBlock Text="If the fish is nearer to the cameras at some other point in the video then Cancel &amp; re-measure at that point to ensure the fish is included in the final survey results" TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
        </InfoBar>

        <!-- Horizontal rule info bar -->
        <InfoBar x:Name="HorizRangeRuleInfoBar"
                 Grid.Row="0" Grid.ColumnSpan="2"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Title="Horizontal rule violation"                 
                 Margin="0,0,0,8">
            <ToolTipService.ToolTip>
                <ToolTip MaxWidth="520">
                    <StackPanel>
                        <TextBlock Text="Outside of the allowed horizontal range from the camera rig centre" TextWrapping="Wrap" />
                        <TextBlock Text="If the fish is nearer to the camera centre at some other point in the video then Cancel &amp; re-measure at that point to ensure the fish is included in the final survey results" TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
        </InfoBar>

        <!-- Vertical rule info bar -->
        <InfoBar x:Name="VertRangeRuleInfoBar"
                 Grid.Row="0" Grid.ColumnSpan="2"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Title="Vertical rule violation"                 
                 Margin="0,0,0,8">
            <ToolTipService.ToolTip>
                <ToolTip MaxWidth="520">
                    <StackPanel>
                        <TextBlock Text="Outside of the allowed vertical range from the camera rig centre" TextWrapping="Wrap" />
                        <TextBlock Text="If the fish is nearer to the camera centre at some other point in the video then Cancel &amp; re-measure at that point to ensure the fish is included in the final survey results" TextWrapping="Wrap" />
                    </StackPanel>
                </ToolTip>
            </ToolTipService.ToolTip>
        </InfoBar>
        
        <!-- Species -->
        <TextBlock Grid.Row ="1" Grid.Column="0" Text="Species:" VerticalAlignment="Center"/>
        <AutoSuggestBox x:Name="AutoSuggestSpecies" Grid.Row ="1" Grid.Column="1" Margin="10,10,0,0" HorizontalAlignment="Left"
                        PlaceholderText="Search" QueryIcon="Find" Width="350"
                        TextChanged="AutoSuggestBoxSpecies_TextChanged"
                        QuerySubmitted="AutoSuggestBoxSpecies_QuerySubmitted"
                        SuggestionChosen="AutoSuggestBoxSpecies_SuggestionChosen"/>
        <!-- Genus -->
        <TextBlock Grid.Row ="2" Grid.Column="0" Text="Genus:" VerticalAlignment="Center"/>
        <AutoSuggestBox x:Name="AutoSuggestGenus" Grid.Row ="2" Grid.Column="1" Margin="10,10,0,0" HorizontalAlignment="Left"
                        PlaceholderText="Search" QueryIcon="Find" Width="350"
                        TextChanged="AutoSuggestBoxGenus_TextChanged"
                        QuerySubmitted="AutoSuggestBoxGenus_QuerySubmitted"
                        SuggestionChosen="AutoSuggestBoxGenus_SuggestionChosen"/>
        <!-- Family -->
        <TextBlock Grid.Row ="3" Grid.Column="0" Text="Family:" VerticalAlignment="Center"/>
        <AutoSuggestBox x:Name="AutoSuggestFamily" Grid.Row ="3" Grid.Column="1" Margin="10,10,0,0" HorizontalAlignment="Left"
                        PlaceholderText="Search" QueryIcon="Find" Width="350"
                        TextChanged="AutoSuggestBoxFamily_TextChanged"
                        QuerySubmitted="AutoSuggestBoxFamily_QuerySubmitted"
                        SuggestionChosen="AutoSuggestBoxFamily_SuggestionChosen"/>

        <!-- Number of fish -->
        <TextBlock Grid.Row ="4" Grid.Column="0" Text="Number of Fish:" VerticalAlignment="Center"/>
        <!--<NumberBox x:Name="NumberBoxNumberOfFish" Grid.Row ="3" Grid.Column="1" Margin="10,10,0,0"
                        Value="1" Width="70" HorizontalAlignment="Left"
                        SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Minimum="1" Maximum="999" />-->
        <TextBox x:Name="NumberBoxNumberOfFish"
                         Grid.Row="4" Grid.Column="1" Margin="10,10,0,0"
                         Width="70" HorizontalAlignment="Left"
                         Text="1"
                         PreviewKeyDown="TextBoxNumberOnly_PreviewKeyDown"
                         TextChanged="TextBoxNumberOnly_TextChanged"/>


        <!--<TextBlock Text="Life Stage:" Margin="0,6,0,2"/>
        <ComboBox x:Name="ComboBoxLifeStage" />-->

        <!--<TextBlock Grid.Row ="4" Grid.Column="0" Text="Comment:" Margin="0,10,0,2"/>-->
        <TextBox x:Name="TextBoxComment" Grid.Row ="6" Grid.Column="0" Grid.ColumnSpan="2" 
                 PlaceholderText="Comment"
                 Margin="0,10,0,0"/>


        <!-- Shows the Source and genus/Species and when expanded the Environment, Distrubtion and Size info -->
        <Expander x:Name="SpeciesInfoExpander" IsExpanded="False" Grid.Row ="7" Grid.ColumnSpan="2"  MaxWidth="460" 
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
            <Expander.Header>
                <Grid Height="Auto" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- GenusSpecies -->
                    <!--<TextBlock x:Name="GenusSpecies" Grid.Column="0"
                                VerticalAlignment="Center" />-->
                    <RichTextBlock x:Name="GenusSpecies" Grid.Column="0" 
                                    IsTextSelectionEnabled="True" 
                                    VerticalAlignment="Center"/>

                    <!-- Source Credit -->
                    <TextBlock x:Name="SourceCredit" Grid.Column="1"
                                    FontStyle="Italic"
                                    FontSize="12"
                                    VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Expander.Header>

            <Grid x:Name="SpeciesInfoGrid" HorizontalAlignment="Stretch" MaxWidth="460">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Environment -->
                <TextBlock Text="Environment:" Grid.Row="0" Grid.Column="0" 
                           FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right" />
                <TextBlock x:Name="Environment" Grid.Row="0" Grid.Column="1"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Distribution -->
                <TextBlock Text="Distribution:" Grid.Row="1" Grid.Column="0"
                           FontWeight="Bold" Margin="0,12,8,0" HorizontalAlignment="Right" />
                <TextBlock x:Name="Distribution" Grid.Row="1" Grid.Column="1"           
                           TextWrapping="Wrap" Margin="0,12,0,0"                           
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Size -->
                <TextBlock Text="Size:" Grid.Row="2" Grid.Column="0"
                           FontWeight="Bold" Margin="0,12,8,0" HorizontalAlignment="Right" />
                <TextBlock x:Name="SpeciesSize" Grid.Row="2" Grid.Column="1"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Expander>




        <GridView x:Name="ImageGridView"
                    Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" 
                    MaxWidth="490"
                    Width="Auto"
                    ItemsSource="{x:Bind ImageList, Mode=OneWay}"
                    ItemTemplate="{StaticResource ImageTemplate}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    Margin="0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Width" Value="240"/>
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

    </Grid>

</UserControl>
