<UserControl
    x:Class="Surveyor.User_Controls.ReplicatesUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Controls .png used to handle both dark and light theme -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:String x:Key="WavesImageSource">/Assets/waves-Light.png</x:String>
                    <x:String x:Key="BuoyImageSource">/Assets/buoy-Light.png</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:String x:Key="WavesImageSource">/Assets/waves-Dark.png</x:String>
                    <x:String x:Key="BuoyImageSource">/Assets/buoy-Dark.png</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Use to define the column width of programmatically added columns -->
            <x:Double x:Key="ReplicateColumnWidthValue">32</x:Double>

            <!-- Styles for the replicate double headed arrow graphic -->
            <Style x:Key="ArrowIconStyle" TargetType="PathIcon">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,15,0,0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Styles for the replicate number text -->
            <Style x:Key="ReplicateNumberStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- Styles for the replicate checkbox -->
            <Style x:Key="ReplicateCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Content" Value="" />
                <Setter Property="Margin" Value="5,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="gridRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="CheckBoxRow" Height="Auto" />
        </Grid.RowDefinitions>
    </Grid>
</UserControl>
