<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Surveyor.User_Controls.SettingsCalibration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"   
    xmlns:local="using:Surveyor.User_Controls"
    xmlns:cal="using:SurveyorCalibrationData"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:toolkit1="using:CommunityToolkit.WinUI.UI.Controls"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:PreferredCalibrationItemVisibilityConverter x:Key="PreferredCalibrationItemVisibilityConverter" />
        <local:DoubleFormatConverter x:Key="Double2Converter" Format="F2" />
        <local:DoubleFormatConverter x:Key="Double3Converter" Format="F3" />
        <local:CalibrationIntrinsicElementConverter x:Key="IntrinsicElementConverter" />
        <local:DoubleSubtractConverter x:Key="MinusCardPaddingConverter" />
        <local:CalibrationDistortionElementConverter x:Key="DistortionElementConverter" />
        <local:StereoMatrixVectorConverter x:Key="StereoMatrixVectorConverter" />
    </UserControl.Resources>

    <toolkit:SettingsExpander  x:Name="SettingsExpanderCalibration" Header="Calibration">
        <toolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xEB3C;" />
        </toolkit:SettingsExpander.HeaderIcon>

        <toolkit:SettingsExpander.Items>
            <!-- MULTIPLE CALIBRATION SETS -->
            <toolkit:SettingsCard Header="Multiple Calibration Sets" Description="">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE762;" ToolTipService.ToolTip="Allow multiple calibrations to be stored. Useful for testing calibration."/>
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleSwitch IsOn="{x:Bind calibration.AllowMultipleCalibrationData, Mode=TwoWay}" 
                                  HorizontalAlignment="Right"/>
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Name="CalibrationCard" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel Padding="12">
                    <!-- Calibration DataGrid (use its own internal ScrollViewer) -->
                    <dg:DataGrid x:Name="CalibrationDataGrid"
                                 ItemsSource="{x:Bind calibration.CalibrationDataList, Mode=OneWay}"
                                 AutoGenerateColumns="False"
                                 HeadersVisibility="Column"
                                 IsReadOnly="True"
                                 GridLinesVisibility="Horizontal"
                                 SelectionMode="Single"
                                 MaxHeight="300"
                                 HorizontalAlignment="Stretch"
                                 MaxWidth="{Binding ElementName=CalibrationCard, Path=ActualWidth, Converter={StaticResource MinusCardPaddingConverter}, ConverterParameter=24}"
                                 SelectionChanged="CalibrationDataGrid_SelectionChanged"
                                 Loaded="CalibrationDataGrid_Loaded"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <dg:DataGrid.Columns>
                            <!-- Star column -->
                            <dg:DataGridTemplateColumn Width="28" Header="">
                                <dg:DataGridTemplateColumn.CellTemplate>
                                    <!-- DataContext is the row's CalibrationData item -->
                                    <DataTemplate x:DataType="cal:CalibrationData">
                                        <TextBlock Text="*"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Converter={StaticResource PreferredCalibrationItemVisibilityConverter}}"/>
                                    </DataTemplate>
                                </dg:DataGridTemplateColumn.CellTemplate>
                            </dg:DataGridTemplateColumn>

                            <!-- Description -->
                            <dg:DataGridTextColumn Header="Description" Binding="{Binding Description}" />

                            <!-- Left camera RMS -->
                            <dg:DataGridTextColumn Header="L RMS"
                                                   Binding="{Binding LeftCameraCalibration.RMS, Converter={StaticResource Double2Converter}}" />

                            <!-- Left camera intrinsics -->
                            <dg:DataGridTextColumn Header="L Fx"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='L,0,0,F3'}" />
                            <dg:DataGridTextColumn Header="L Fy"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='L,1,1,F3'}" />
                            <dg:DataGridTextColumn Header="L Cx"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='L,0,2,F3'}" />
                            <dg:DataGridTextColumn Header="L Cy"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='L,1,2,F3'}" />

                            <!-- Left camera distortion coefficients [k1,k2,p1,p2,k3,k4,k5,k6] -->
                            <dg:DataGridTextColumn Header="L K1" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,0,F3'}" />
                            <dg:DataGridTextColumn Header="L K2" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,1,F3'}" />
                            <dg:DataGridTextColumn Header="L P1" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,2,F3'}" />
                            <dg:DataGridTextColumn Header="L P2" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,3,F3'}" />
                            <dg:DataGridTextColumn Header="L K3" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,4,F3'}" />
                            <dg:DataGridTextColumn Header="L K4" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,5,F3'}" />
                            <dg:DataGridTextColumn Header="L K5" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,6,F3'}" />
                            <dg:DataGridTextColumn Header="L K6" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='L,7,F3'}" />

                            <!-- Left camera ID -->
                            <dg:DataGridTextColumn Header="L ID" Binding="{Binding LeftCameraCalibration.CameraID}" />

                            <!-- Right camera RMS (3 dp) -->
                            <dg:DataGridTextColumn Header="R RMS"
                                                   Binding="{Binding RightCameraCalibration.RMS, Converter={StaticResource Double3Converter}}" />

                            <!-- Right camera intrinsics (3 dp) -->
                            <dg:DataGridTextColumn Header="R Fx"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='R,0,0,F3'}" />
                            <dg:DataGridTextColumn Header="R Fy"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='R,1,1,F3'}" />
                            <dg:DataGridTextColumn Header="R Cx"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='R,0,2,F3'}" />
                            <dg:DataGridTextColumn Header="R Cy"
                                                   Binding="{Binding Converter={StaticResource IntrinsicElementConverter}, ConverterParameter='R,1,2,F3'}" />

                            <!-- Right camera distortion coefficients [k1,k2,p1,p2,k3,k4,k5,k6] (3 dp) -->
                            <dg:DataGridTextColumn Header="R K1" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,0,F3'}" />
                            <dg:DataGridTextColumn Header="R K2" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,1,F3'}" />
                            <dg:DataGridTextColumn Header="R P1" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,2,F3'}" />
                            <dg:DataGridTextColumn Header="R P2" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,3,F3'}" />
                            <dg:DataGridTextColumn Header="R K3" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,4,F3'}" />
                            <dg:DataGridTextColumn Header="R K4" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,5,F3'}" />
                            <dg:DataGridTextColumn Header="R K5" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,6,F3'}" />
                            <dg:DataGridTextColumn Header="R K6" Binding="{Binding Converter={StaticResource DistortionElementConverter}, ConverterParameter='R,7,F3'}" />

                            <!-- Right camera ID -->
                            <dg:DataGridTextColumn Header="R ID" Binding="{Binding RightCameraCalibration.CameraID}" />

                            <!-- Stereo RMS + vectors -->
                            <dg:DataGridTextColumn Header="RMS" Binding="{Binding StereoCameraCalibration.RMS, Converter={StaticResource Double2Converter}}" />
                            <dg:DataGridTextColumn Header="Rotation" Binding="{Binding Converter={StaticResource StereoMatrixVectorConverter}, ConverterParameter='Rot,F2'}" />
                            <dg:DataGridTextColumn Header="Transform" Binding="{Binding Converter={StaticResource StereoMatrixVectorConverter}, ConverterParameter='Trans,F2'}" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>

                    <!-- Control buttons below grid -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8" Margin="0,6,0,0">
                        <Button x:Name="PreferredMinusButton" Click="PreferredMinusButton_Click">
                            <Button.Content>
                                <FontIcon Glyph="&#xE96D;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                            </Button.Content>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Move preferred calibration"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button x:Name="PreferredPlusButton" Click="PreferredPlusButton_Click">
                            <Button.Content>
                                <FontIcon Glyph="&#xE96E;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                            </Button.Content>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Move preferred calibration"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button x:Name="DeleteCalibrationButton" Click="DeleteCalibrationButton_Click" Margin="0,0,12,0">
                            <Button.Content>
                                <FontIcon Glyph="&#xE74D;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                            </Button.Content>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Delete selected calibration"/>
                            </ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </toolkit:SettingsCard>

        </toolkit:SettingsExpander.Items>
    </toolkit:SettingsExpander>


</UserControl>
