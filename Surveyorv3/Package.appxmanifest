<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="TobySolo.312674E3C56F2"
    Publisher="CN=BBFC9555-B064-4A94-B7B3-FE2E887C0C99"
    Version="3.1.170.0" />

  <mp:PhoneIdentity PhoneProductId="a9f6610b-6aaa-4a93-abe4-1fe85f391ddc" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Underwater Surveyor</DisplayName>
    <PublisherDisplayName>TobySolo</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
		<uap:VisualElements
		  DisplayName="Underwater Surveyor"
		  Description="Fish measurement survey software.  This software is used to process videos from a sterographic camera rig."
		  BackgroundColor="transparent"
		  Square44x44Logo="Assets\Logo.png"
		  Square150x150Logo="Assets\SquareLogo.png">
			<uap:DefaultTile Wide310x150Logo="Assets\WideLogo.png">
				<uap:ShowNameOnTiles>
					<uap:ShowOn Tile="square150x150Logo"/>
					<uap:ShowOn Tile="wide310x150Logo"/>
				</uap:ShowNameOnTiles>
			</uap:DefaultTile >
			<uap:SplashScreen Image="Assets\SplashScreen.png" />
			<uap:InitialRotationPreference>
				<uap:Rotation Preference="landscape"/>
			</uap:InitialRotationPreference>
		</uap:VisualElements>
		<Extensions>
			<!-- File type association -->
			<uap:Extension Category="windows.fileTypeAssociation">
				<uap:FileTypeAssociation Name="surveyor">
					<uap:SupportedFileTypes>
						<uap:FileType ContentType="application/survey">.survey</uap:FileType>
					</uap:SupportedFileTypes>
					<uap:DisplayName>Survey File</uap:DisplayName>
					<uap:InfoTip>Underwater Surveyor Survey File</uap:InfoTip>
					<uap:Logo>Assets\StoreLogo-Master700x700-Dark.png</uap:Logo>
				</uap:FileTypeAssociation>
			</uap:Extension>
			
			<!-- New: App Execution Alias -->
			<uap5:Extension Category="windows.appExecutionAlias">
				<uap5:AppExecutionAlias>
					<uap5:ExecutionAlias Alias="UnderwaterSurveyor.exe" />
				</uap5:AppExecutionAlias>
			</uap5:Extension>

			<!-- New: Custom Protocol -->
			<uap:Extension Category="windows.protocol">
				<uap:Protocol Name="underwatersurveyor">
					<uap:DisplayName>Underwater Surveyor Link</uap:DisplayName>
				</uap:Protocol>
			</uap:Extension>
		</Extensions>
    </Application>
  </Applications>

  <Capabilities>
	<rescap:Capability Name="runFullTrust" />
	<uap:Capability Name="userAccountInformation"/>
    <Capability Name="internetClient"/>
    <uap:Capability Name="objects3D"/>
    <uap:Capability Name="removableStorage"/>
    <uap:Capability Name="videosLibrary"/>
    <DeviceCapability Name="bluetooth"/>
  </Capabilities>
</Package>
